# --- Required -----------------------------------------------------------------
# PostgreSQL connection string. Local dev (npm run dev) starts a server on port 5433 with this URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/nivas?schema=public"

# Random string >= 32 chars used to sign session cookies. REQUIRED in production.
#   openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- Optional -----------------------------------------------------------------
# The first registered account becomes administrator (set to "false" to disable).
FIRST_USER_IS_ADMIN="true"
# Dev launcher overrides:
# PORT=3000
# PG_PORT=5433
# PG_DATA_DIR=.pgdata
